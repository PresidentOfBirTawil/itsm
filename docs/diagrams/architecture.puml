@startuml architecture
!include style.iuml
' Layers and packages, and which way the dependencies point.
title Quell · System architecture

skinparam componentStyle rectangle
skinparam defaultTextAlignment center
actor "Employee\nTechnician\nAdministrator" as User

node "Browser or installed app (PWA / desktop launcher)" as Browser {
  [HTML pages · Bootstrap 5\ndark / light theme] as Pages
  [live.js\nserver-sent events] as LiveJs
  [assistant.js · voice input\nattachments.js · palette] as Js
  [service worker\noffline page · alerts] as SW
}

cloud "Your tools" as Tools {
  [Scripts · monitoring\n(REST API client)] as ApiClient
  [Slack · Microsoft Teams\nany webhook receiver] as Receivers
}

node "Quell server: one Spring Boot 4.1 application (Java 25, embedded Tomcat)" as App {

  rectangle "Security · com.quell.security, com.quell.api" as Sec {
    [Web chain: form login · BCrypt · CSRF\nsessions · lockout · CSP headers] as WebChain
    [API chain: bearer API keys (SHA-256)\nstateless · rate limit · problem JSON] as ApiChain
  }

  rectangle "Presentation" as Web {
    [Web controllers + Thymeleaf\nemployee · technician · admin\nassistant · status · knowledge] as Controllers
    [REST controllers /api/v1\nOpenAPI docs /api/docs] as Rest
    [ErrorHandler · ApiExceptionHandler] as Errors
  }

  rectangle "Application services" as Services {
    [IncidentService\nIncidentFactory] as IncidentSvc
    [AssignmentService\n3 strategies] as AssignSvc
    [SlaService\nSlaMonitor @Scheduled] as SlaSvc
    [ReportingAssistant\n(chat, State pattern)] as Assistant
    [AttachmentService\nKnowledgeService] as Content
    [StatusService\nServiceGraph · RootCauseAnalyzer] as Status
    [ApiTokenService\nWebhookService] as Integrations
  }

  rectangle "Intelligence · com.quell.intelligence, priority, sla" as Intel {
    [PriorityCalculator\nimpact × urgency × criticality] as Prio
    [CategoryClassifier\nnaive Bayes] as NB
    [ResolutionRecommender\nDuplicateDetector · TF-IDF] as TfIdf
    [SlaPredictor\nTriageAdvisor · ServiceDetector] as Predict
  }

  rectangle "Events (Observer) · com.quell.event" as Events {
    [IncidentEventPublisher] as Publisher
    [AuditTrailListener] as AuditL
    [NotificationListener\nin-app · live · email] as NotifL
    [LiveUpdateListener\nLiveUpdates (SSE)] as LiveL
    [WebhookListener\n(transactional outbox)] as HookL
    [WebhookDispatcher\nsigned · retried] as HookD
  }

  rectangle "Domain model · com.quell.domain" as Domain {
    [Incident + 9 state classes] as IncidentD
    [User · Employee · Technician · Administrator] as UsersD
    [ITService · Category · SlaPolicy · KnowledgeArticle\nAttachment · ApiToken · Webhook · AuditEntry] as OtherD
  }

  rectangle "Persistence · com.quell.repository" as Persistence {
    [Spring Data JPA repositories\nSpecifications · Hibernate 7] as Repos
  }
}

database "H2 (desktop, development)\nPostgreSQL (server, Docker)" as DB

User --> Pages
Pages --> WebChain : HTTPS · session cookie · CSRF token
Js --> WebChain
ApiClient --> ApiChain : HTTPS · Authorization: Bearer qk_…
WebChain --> Controllers
ApiChain --> Rest
Controllers --> IncidentSvc
Controllers --> Assistant
Controllers --> Content
Controllers --> Status
Controllers --> Integrations
Rest --> IncidentSvc
Rest --> Status
Errors .. Controllers
Assistant --> IncidentSvc
IncidentSvc --> Prio
IncidentSvc --> AssignSvc
IncidentSvc --> SlaSvc
IncidentSvc --> TfIdf
IncidentSvc --> NB
SlaSvc --> Predict
IncidentSvc --> Publisher
AssignSvc --> Publisher
SlaSvc --> Publisher
Publisher --> AuditL
Publisher --> NotifL
Publisher --> LiveL
Publisher --> HookL
Publisher --> NB : retrain
HookL --> HookD : after commit
HookD --> Receivers : POST JSON\nHMAC-SHA256 signature
LiveL ..> LiveJs : "incident", "bell"\n(after commit)
LiveJs ..> SW : desktop alert
IncidentSvc --> IncidentD
AssignSvc --> UsersD
Services --> Repos
Events --> Repos
Repos --> DB : JDBC
Repos ..> Domain : maps entities

note right of Domain
  The rules live here. The domain model
  depends on nothing above it: no Spring MVC,
  no web, no repositories.
end note
@enduml
