@startuml pattern-exceptions
!include style.iuml
' One exception class per broken rule, all under QuellException.

set separator none
left to right direction
hide empty members
skinparam nodesep 6
skinparam ranksep 40

class RuntimeException
abstract class QuellException
class InvalidStateTransitionException
class TechnicianUnavailableException
class WorkloadExceededException
class MissingSlaConfigurationException
class DuplicateIncidentException
class UnauthorizedOperationException
class InvalidInputException
class EmailAlreadyRegisteredException
class NotFoundException
class IncidentNotFoundException
class ServiceNotFoundException

RuntimeException <|-- QuellException
QuellException <|-- InvalidStateTransitionException
QuellException <|-- TechnicianUnavailableException
QuellException <|-- WorkloadExceededException
QuellException <|-- MissingSlaConfigurationException
QuellException <|-- DuplicateIncidentException
QuellException <|-- UnauthorizedOperationException
QuellException <|-- InvalidInputException
QuellException <|-- NotFoundException
InvalidInputException <|-- EmailAlreadyRegisteredException
NotFoundException <|-- IncidentNotFoundException
NotFoundException <|-- ServiceNotFoundException
@enduml
