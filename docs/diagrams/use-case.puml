@startuml use-case
!include style.iuml
' Use case diagram: who can do what in Quell.
title Quell · Use cases

left to right direction
skinparam packageStyle rectangle
actor "Visitor" as Visitor
actor "Employee" as Employee
actor "Technician" as Technician
actor "Administrator" as Admin
actor "Scheduler\n(every minute)" as Timer <<system>>
actor "External tool\n(REST API key)" as Tool <<system>>
actor "Slack · Teams · app\n(webhook receiver)" as Receiver <<system>>

rectangle "Quell" {
  package "Account" {
    usecase "Register as an employee" as UC_Register
    usecase "Sign in / sign out\n(paused after 5 wrong passwords)" as UC_Login
    usecase "Read notifications\nand desktop alerts" as UC_Notifications
    usecase "Manage personal API keys" as UC_Keys
  }

  package "Reporting" {
    usecase "Report an incident\n(form, with screenshot)" as UC_Report
    usecase "Report by chatting\nwith the assistant (voice)" as UC_Chat
    usecase "Join a known problem\n(\"I'm affected too\")" as UC_Join
    usecase "Check service status" as UC_Status
    usecase "Search the knowledge base" as UC_KB
    usecase "Track own incidents" as UC_Track
    usecase "Attach a file" as UC_Attach
    usecase "Confirm the fix or reopen" as UC_Verify
    usecase "Rate the resolution" as UC_Rate
  }

  package "Resolution" {
    usecase "View assigned queue" as UC_Queue
    usecase "Acknowledge and start work" as UC_Ack
    usecase "Use a suggested solution" as UC_Suggested
    usecase "Request information" as UC_Request
    usecase "Resolve with a resolution note" as UC_Resolve
    usecase "Save the fix as an article" as UC_Article
    usecase "Change classification" as UC_Reclassify
    usecase "Search all incidents" as UC_Search
  }

  package "Administration" {
    usecase "Monitor the live dashboard\n(SLA risk, root cause)" as UC_Dashboard
    usecase "Assign or reassign a technician" as UC_Assign
    usecase "Manage users, technicians,\nservices, dependencies, SLAs" as UC_Catalogue
    usecase "Choose the assignment strategy" as UC_Strategy
    usecase "View reports and the audit log" as UC_Reports
    usecase "Connect webhooks" as UC_Webhooks
  }

  package "Automatic" {
    usecase "Calculate priority and SLA deadlines" as UC_Priority
    usecase "Classify (keywords, naive Bayes)" as UC_Classify
    usecase "Detect a possible duplicate" as UC_Duplicate
    usecase "Assign a technician automatically" as UC_AutoAssign
    usecase "Audit, notify, update pages live" as UC_Notify
    usecase "Send webhooks (signed, retried)" as UC_Send
    usecase "Check SLAs, predict breaches,\nescalate unacknowledged P1s" as UC_Check
  }

  package "REST API" {
    usecase "Report and follow incidents\nfrom other systems" as UC_Api
  }
}

Visitor --> UC_Register
Visitor --> UC_Login

Employee --> UC_Login
Employee --> UC_Notifications
Employee --> UC_Keys
Employee --> UC_Report
Employee --> UC_Chat
Employee --> UC_Join
Employee --> UC_Status
Employee --> UC_KB
Employee --> UC_Track
Employee --> UC_Attach
Employee --> UC_Verify
Employee --> UC_Rate

Technician --> UC_Queue
Technician --> UC_Ack
Technician --> UC_Suggested
Technician --> UC_Request
Technician --> UC_Resolve
Technician --> UC_Article
Technician --> UC_Reclassify
Technician --> UC_Search
Technician --> UC_Attach

Admin --> UC_Dashboard
Admin --> UC_Assign
Admin --> UC_Catalogue
Admin --> UC_Strategy
Admin --> UC_Reports
Admin --> UC_Webhooks
Admin --> UC_Search

Timer --> UC_Check
Tool --> UC_Api
UC_Send --> Receiver

UC_Report ..> UC_Priority : <<include>>
UC_Report ..> UC_AutoAssign : <<include>>
UC_Report ..> UC_Duplicate : <<include>>
UC_Classify ..> UC_Report : <<extend>>\nno category chosen
UC_Chat ..> UC_Report : <<include>>
UC_Join ..> UC_Chat : <<extend>>\nknown outage found
UC_Api ..> UC_Report : <<include>>
UC_Resolve ..> UC_Notify : <<include>>
UC_Notify ..> UC_Send : <<include>>\nwhen subscribed
@enduml
